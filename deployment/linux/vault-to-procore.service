[Unit]
Description=Autodesk Vault to Procore document synchronization
After=network-online.target
Wants=network-online.target

[Service]
Type=oneshot
# This account has no interactive shell and only needs write access to state and logs.
User=vault-to-procore
Group=vault-to-procore
WorkingDirectory=/var/lib/vault-to-procore
EnvironmentFile=/etc/vault-to-procore/vault-to-procore.env
ExecStart=/opt/vault-to-procore/vault-to-procore --live
# Keep a compromised connector from gaining privileges or writing elsewhere on the host.
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=true
ReadWritePaths=/var/lib/vault-to-procore /var/log/vault-to-procore

# Safe default: no files are uploaded unless --live is passed.
DRY_RUN=true

# Vault connection. The root may be narrowed during rollout so the first test
# does not scan the customer's entire repository.
VAULT_BASE_URL=https://your-vault-data-api.example.com
VAULT_ROOT_PATH=$/
VAULT_ACCESS_TOKEN=

# Procore connection. Keep tokens out of this checked-in example and place the
# real values only in the protected server copy.
PROCORE_BASE_URL=https://api.procore.com
PROCORE_COMPANY_ID=
PROCORE_ACCESS_TOKEN=

# Local state and service behavior. Relative paths resolve from the application's
# working directory, which the supplied installers set explicitly.
SYNC_STATE_FILE=sync_state.db
REQUEST_TIMEOUT_SECONDS=60
VERIFY_AFTER_HOURS=24
SYNC_LOG_FILE=logs/vault-to-procore.log
SYNC_LOCK_FILE=vault-to-procore.lock
RETRY_ATTEMPTS=4
SERVICE_INTERVAL_SECONDS=900
# Safety gate. Do not enable until the exact Vault deployment routes and the
# Procore upload/folder/version workflow have passed integration testing.
API_CONTRACT_CONFIRMED=false

# Override these when the approved API routes differ.
# They are grouped here because Vault deployments and approved API versions can
# differ; changing them should not require rebuilding the executable.
VAULT_FILES_ROUTE=/folders/files
VAULT_DOWNLOAD_ROUTE=/files/{file_id}/download
PROCORE_PROJECTS_ROUTE=/rest/v1.1/projects
PROCORE_DOCUMENT_LOOKUP_ROUTE=/rest/v1.0/documents
PROCORE_DOCUMENT_UPLOAD_ROUTE=/rest/v1.0/documents
PROCORE_VERSION_UPLOAD_ROUTE=/rest/v1.0/documents/{document_id}/versions
